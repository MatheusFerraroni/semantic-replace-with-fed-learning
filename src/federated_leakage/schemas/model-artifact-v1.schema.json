{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://federated-leakage.invalid/schemas/model-artifact-v1.schema.json",
  "title": "Tucano 2 model artifact manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "format",
    "parent_model",
    "architecture",
    "tokenizer",
    "training",
    "environment",
    "files",
    "artifact_sha256",
    "redistribution_status"
  ],
  "properties": {
    "schema_version": {
      "const": "tucano2-model-artifact/v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "format": {
      "const": "transformers_pretrained"
    },
    "parent_model": {
      "type": "object",
      "required": ["model_id", "revision", "license"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "model_type",
        "parameter_count",
        "native_context_length",
        "training_sequence_length"
      ],
      "properties": {
        "model_type": {"type": "string", "minLength": 1},
        "parameter_count": {"type": "integer", "minimum": 1},
        "native_context_length": {"type": "integer", "minimum": 1},
        "training_sequence_length": {"type": "integer", "minimum": 1}
      }
    },
    "tokenizer": {
      "type": "object",
      "required": [
        "fingerprint_sha256",
        "files",
        "vocab_size",
        "bos_token_id",
        "eos_token_id",
        "pad_token_id",
        "unk_token_id"
      ],
      "properties": {
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "vocab_size": {"type": "integer", "minimum": 1},
        "bos_token_id": {"type": ["integer", "null"]},
        "eos_token_id": {"type": ["integer", "null"]},
        "pad_token_id": {"type": ["integer", "null"]},
        "unk_token_id": {"type": ["integer", "null"]}
      }
    },
    "training": {
      "type": "object",
      "required": [
        "method",
        "producer_git_commit",
        "run_id",
        "seed",
        "resolved_config_sha256",
        "dataset_manifest_sha256"
      ],
      "properties": {
        "method": {"const": "full_parameter_continual_pretraining"},
        "producer_git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "resolved_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["python", "torch", "transformers", "tokenizers"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "torch": {"type": "string", "minLength": 1},
        "transformers": {"type": "string", "minLength": 1},
        "tokenizers": {"type": "string", "minLength": 1}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "redistribution_status": {
      "const": "internal_research_only"
    }
  }
}
